{
  "name": "web-pwa-ios-starter",
  "private": true,
  "version": "0.1.4",
  "packageManager": "pnpm@11.9.0",
  "type": "module",
  "bin": {
    "create-pwa-app": "./bin/create-pwa-app.mjs"
  },
  "scripts": {
    "clean": "node ./scripts/clean.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "generate:pwa-assets": "pwa-assets-generator --preset minimal-2023 public/favicon.svg",
    "init-app": "node ./scripts/init-app.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "version:bump": "pnpm version patch --no-git-tag-version",
    "deploy": "pnpm run version:bump && pnpm run build && node ./scripts/youpai-sync.mjs"
  },
  "dependencies": {
    "konsta": "^5.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vite-pwa/assets-generator": "^1.0.4",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
